# ==============================================================================
# PPMS (Project Progress Monitoring System) - Environment Configuration Template
# ZERO-COST POLICY: All core features operate 100% locally with zero paid services.
# Copy this file to .env in your backend and frontend directories as needed.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Security & JWT Authentication
# In production, replace with a secure randomly generated string (e.g. openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_DEPLOYMENT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local zero-config SQLite; use PostgreSQL URL in production)
DATABASE_URL=sqlite:///./ppms.db
# For Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Initial Database Seed Passwords (Environment-only settings, no defaults)
SEED_HOD_PASSWORD=
SEED_ADVISOR_PASSWORD=
SEED_MENTOR_PASSWORD=
SEED_STUDENT_PASSWORD=

# Storage & File Upload Quota
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=15728640

# Network & CORS Origins
FRONTEND_ORIGIN=http://127.0.0.1:5173
BACKEND_ORIGIN=http://127.0.0.1:8000

# ==============================================================================
# OPTIONAL SMTP EMAIL CONFIGURATION
# Notice: The application operates completely without SMTP (In-App notifications active).
# Leave EMAIL_ENABLED=false for purely offline, zero-cost operation.
# ==============================================================================
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply-ppms@college.edu
SMTP_FROM_NAME=PPMS Academic Notification
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

