# ==============================================================================
# PPMS Root .gitignore - Strict Security and Cleanliness Standards
# ==============================================================================

# Environment and Secret Files
.env
.env.*
!.env.example

# Local SQLite Databases & Backups (Keep seeded dev database out of public git commits)
backend/backups/
backups/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sha256

# Uploaded Files & User Content
backend/uploads/documents/*
uploads/documents/*
!backend/uploads/documents/.gitkeep
!uploads/documents/.gitkeep

# Python Artifacts & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.local
frontend/*.local

# Logs and Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Reports and Traces
test-results/
playwright-report/
frontend/test-results/
frontend/playwright-report/

# IDE and Editor Files
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# PPMS security exclusions
*.db
*.db.*
*.backup
*.bak
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sha256
backend/backups/
backups/
backend/uploads/
uploads/

# Environment files and secrets
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Build and dependency directories
node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
dist/
coverage/
