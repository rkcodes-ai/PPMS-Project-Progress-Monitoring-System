# Frontend Environment Configuration Template
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# In production on Render, set VITE_API_BASE_URL to your Render web service URL (e.g. https://ppms-backend.onrender.com/api/v1)

# Set to "true" only if hosting an open staging demo; defaults to "false" to prevent privileged credential auto-fill
VITE_ENABLE_DEMO_LOGIN=false
