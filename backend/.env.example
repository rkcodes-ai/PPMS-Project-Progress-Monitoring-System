# PPMS Backend Environment Configuration Template
APP_ENV=development
LOG_LEVEL=INFO

SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_DEPLOYMENT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./ppms.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=15728640

FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional SMTP
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply-ppms@college.edu
SMTP_FROM_NAME=PPMS Academic Notification
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

